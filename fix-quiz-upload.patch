+           ADD COLUMN IF NOT EXISTS "assignedAt" TIMESTAMPTZ NOT NULL DEFAULT NOW()`,
+        transaction,
+      );
+      await run(
+        `UPDATE class_quizzes SET "assignedAt" = "createdAt" WHERE "createdAt" IS NOT NULL`,
+        transaction,
+      );
