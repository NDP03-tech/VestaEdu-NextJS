+           DROP COLUMN IF EXISTS "assignedAt",
+           DROP COLUMN IF EXISTS "isActive",
+           DROP COLUMN IF EXISTS "dueDate",
+           DROP COLUMN IF EXISTS "id"`,
+        transaction,
+      );
+      await run(
+        `ALTER TABLE class_quizzes ADD PRIMARY KEY (class_id, quiz_id)`,
+        transaction,
