+        `ALTER TABLE class_quizzes DROP CONSTRAINT IF EXISTS class_quizzes_pkey`,
+        transaction,
+      );
+      await run(`ALTER TABLE class_quizzes ADD PRIMARY KEY ("id")`, transaction);
+      await run(
+        `DO $$ BEGIN
+           IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'class_quizzes_class_id_quiz_id_key') THEN
+             ALTER TABLE class_quizzes
+               ADD CONSTRAINT class_quizzes_class_id_quiz_id_key UNIQUE (class_id, quiz_id);
+           END IF;
+         END $$`,
+        transaction,
+      );
