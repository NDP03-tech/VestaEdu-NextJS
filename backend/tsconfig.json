{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "moduleResolution": "node16",
    "types": ["node"],

    // ✅ Bắt buộc cho TypeORM decorator
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "index.ts",
    "domain/**/*.ts",
    "infrastructure/**/*.ts",
    "config/**/*.ts",
    "utils/**/*.ts",
    "applications/**/*.ts",
    "infrastructure/persistence/**/*.ts" // ✅ thêm dòng này nếu bạn vẫn để entity trong models/
  ],
  "exclude": ["node_modules", "dist"]
}
